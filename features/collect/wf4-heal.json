    {
      "id": "c173cc6a-b424-4a11-a41c-5d961665aff0",
      "name": "Check freshness",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        700,
        540
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Stale = newest real observation older than 15 min (the same window as the cell_status view).\n-- The C11 test cells never count as fresh data. alarmed = the last watchdog line is ALERT DATA STALE.\nselect max(ts) as last_ts,\n       floor(extract(epoch from now() - max(ts)) / 60)::int as age_min,\n       coalesce(max(ts) < now() - interval '15 minutes', true) as stale,\n       coalesce((select action = 'ALERT DATA STALE' from agent_log\n                 where workflow = 'WF4' and action in ('ALERT DATA STALE', 'END STALE ALARM')\n                 order by id desc limit 1), false) as alarmed\nfrom observations\nwhere cell_id not in ('89.5_178.5', '89.5_179.0', '89.5_179.5');",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "name": "AirGuard Postgres"
        }
      }
    },
    {
      "id": "1c7f1bc2-f397-46b0-abc3-b819711afd05",
      "name": "Stale or fresh again?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        920,
        540
      ],
      "parameters": {
        "rules": {
