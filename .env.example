# Copy to .env and fill in. NEVER commit .env
# Every key anyone on the team needs must be listed here with a dummy value,
# so a fresh clone knows exactly what it is missing.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
APIFY_TOKEN=your_apify_token
N8N_BASE_URL=https://your-instance.app.n8n.cloud
N8N_API_KEY=your_n8n_api_key
TELEGRAM_BOT_TOKEN=123456789:your_bot_token
TELEGRAM_CHAT_ID=123456789
TELEGRAM_ALLOWED_USER_IDS=111111111,222222222
GOOGLE_SHEET_ID=your_google_sheet_id
